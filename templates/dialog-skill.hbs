<div class="cprinv-skill-dialog">
  <p><strong>{{actorName}}</strong>{{#if dv}} — {{localize "CPRINV.Clue.Dv"}} {{dv}}{{/if}}</p>
  <div class="form-group">
    <label>{{localize "CPRINV.Dialog.Skill"}}</label>
    <select name="skill">
      {{#if suggested.length}}
        <optgroup label="{{localize "CPRINV.Dialog.Suggested"}}">
          {{#each suggested}}<option value="{{key}}">{{label}}</option>{{/each}}
        </optgroup>
      {{/if}}
      {{#if others.length}}
        <optgroup label="{{localize "CPRINV.Dialog.OtherSkills"}}">
          {{#each others}}<option value="{{key}}">{{label}}</option>{{/each}}
        </optgroup>
      {{/if}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "CPRINV.Dialog.ExtraMod"}}</label>
    <input type="number" name="mod" value="{{penalty}}" step="1">
  </div>
  {{#if note}}<p class="hint">{{note}}</p>{{/if}}
  <p class="hint">{{localize "CPRINV.Dialog.SystemDialogNote"}}</p>
</div>
